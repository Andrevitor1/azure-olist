{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "dfazure-olist1010"
		},
		"AzureDataLakeStorage1_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://dlolist1010.dfs.core.windows.net/"
		},
		"LS_AzureSQL_Olist_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "data-olistcentral.database.windows.net"
		},
		"LS_AzureSQL_Olist_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "free-sql-db-6849147"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "dfazure-olist1010_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"AzureDataLakeStorage1_properties_typeProperties_url": {
						"value": "[parameters('AzureDataLakeStorage1_properties_typeProperties_url')]"
					},
					"LS_AzureSQL_Olist_properties_typeProperties_server": {
						"value": "[parameters('LS_AzureSQL_Olist_properties_typeProperties_server')]"
					},
					"LS_AzureSQL_Olist_properties_typeProperties_database": {
						"value": "[parameters('LS_AzureSQL_Olist_properties_typeProperties_database')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}