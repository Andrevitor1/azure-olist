{
	"name": "DS_ADLS_Olist_Orders",
	"properties": {
		"description": "Source dataset containing Olist order data stored in Azure Data Lake Storage Gen2 in the Raw layer. Used by Azure Data Factory to ingest order records into the `dbo.stg_orders` table in Azure SQL Database.",
		"linkedServiceName": {
			"referenceName": "AzureDataLakeStorage1",
			"type": "LinkedServiceReference"
		},
		"annotations": [],
		"type": "DelimitedText",
		"typeProperties": {
			"location": {
				"type": "AzureBlobFSLocation",
				"fileName": "olist_orders_dataset.csv",
				"fileSystem": "raw"
			},
			"columnDelimiter": ",",
			"escapeChar": "\\",
			"firstRowAsHeader": true,
			"quoteChar": "\""
		},
		"schema": [
			{
				"name": "order_id",
				"type": "String"
			},
			{
				"name": "customer_id",
				"type": "String"
			},
			{
				"name": "order_status",
				"type": "String"
			},
			{
				"name": "order_purchase_timestamp",
				"type": "String"
			},
			{
				"name": "order_approved_at",
				"type": "String"
			},
			{
				"name": "order_delivered_carrier_date",
				"type": "String"
			},
			{
				"name": "order_delivered_customer_date",
				"type": "String"
			},
			{
				"name": "order_estimated_delivery_date",
				"type": "String"
			}
		]
	}
}